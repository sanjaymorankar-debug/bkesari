# ---------------------------------------------------------------------------
# Milk & Dairy Products (bkesari.com) — copy to `.env` and fill in.
#
# NOTHING IN THIS FILE IS A REAL CREDENTIAL, and `.env` is gitignored. Fill the
# real values in on the server only.
#
# One .env per environment, holding ONLY that tier's database URLs. The
# database is PostgreSQL on Neon: one Neon branch per tier, each with a
# database named `bk_milk` owned by the role `bk_milk_app`:
#   production branch -> bkesari.com
#   test branch       -> test.bkesari.com
#   dev branch        -> dev.bkesari.com
# (PostgreSQL 14 or newer works anywhere; CI and local development use 16.)
# See DEPLOYMENT.md §1.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# dev | test | prod. Read from here, never hard-coded, so one build can serve
# any tier against its own database.
APP_ENV=dev
BASE_URL=https://dev.bkesari.com/milk

# The path prefix this app is served under. The hub at bkesari.com forwards
# /milk/ here WITHOUT stripping the prefix, so the app has to own it.
#
# It must match BASE_URL's path, and it must ALSO be set when the build is made
# (the deploy workflow does that) because Next inlines it into the client
# bundles. A build made with it but started without it serves the app at the
# root while every asset URL points at /milk/ — every page then loads as
# unstyled markup. Leave blank only if this app is served from the root of its
# own hostname with nothing in front of it.
BASE_PATH=/milk

# --- Database (PostgreSQL on Neon) ------------------------------------------
# Neon console -> your project -> the tier's branch -> Connect, database `bk_milk`,
# role `bk_milk_app`. Copy the string twice:
#   "Connection pooling" ON  -> DATABASE_URL           (host has -pooler in it)
#   "Connection pooling" OFF -> DATABASE_URL_UNPOOLED  (the direct endpoint)
# The app runs on the pooled one; `npm run db:migrate` (and drizzle-kit) use the
# direct one, because DDL does not belong behind a transaction-mode pooler.
# Keep Neon's `?sslmode=require&channel_binding=require` on the end of both.
# Locally (or in CI) set DATABASE_URL alone; migrations then use it too:
#   postgresql://postgres:postgres@localhost:5432/milk_dev
# Characters such as @ : / # ? in the password must be percent-encoded here.
# Precedence: a variable set in your shell beats this file, and a DATABASE_URL
# set in your shell beats a DATABASE_URL_UNPOOLED from this file, so
# `DATABASE_URL=... npm run db:migrate` migrates the database it names.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Alternatively leave DATABASE_URL blank and fill in the separate fields; the
# app composes the URL from them (the password needs no encoding this way).
# If both are set, DATABASE_URL wins. DB_SSLMODE=require for managed providers.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
DB_SSLMODE=

# A SEPARATE database for `npm test`. The suite TRUNCATEs the application's
# tables between tests, so pointing this at a database with data you care
# about will erase it.
# Required to run the tests at all (tests/setup.ts throws without it); not used
# by the application itself, so it stays blank on a deployed server.
# Give it the schema with `npm run db:migrate:test`, which reads this value:
#   createdb dairy_bakery_test
#   TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dairy_bakery_test
TEST_DATABASE_URL=

# Connection-pool ceiling per app process. On Neon the app talks to the pooler,
# which accepts far more clients than the compute has connections; keep this
# modest anyway, and under the plan's limit if you point DATABASE_URL at a
# direct endpoint.
DATABASE_POOL_MAX=5

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=https://dev.bkesari.com/milk
# Optional Google sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Scheduled jobs --------------------------------------------------------
# Bearer token guarding the daily-order cron endpoint. Generate as above.
CRON_SECRET=

# --- Payments (Cashfree) ---------------------------------------------------
# Leave both blank on dev: payments then run in MOCK mode and take no money.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# --- Google Maps -----------------------------------------------------------
# Two DIFFERENT keys. The server key is IP-restricted and never reaches a
# browser; the public one is domain-restricted. Blank on dev falls back to
# manual address entry rather than failing.
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- PAN encryption --------------------------------------------------------
# Base64 32-byte AES-256-GCM key. Required before any PAN can be submitted;
# there is deliberately no plaintext fallback.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAN_ENCRYPTION_KEY=

# --- GST/PAN verification providers ---------------------------------------
# No provider chosen yet. Blank = self-declared mode: submissions are stored
# PENDING_VERIFICATION for an admin to confirm, never silently verified.
GST_PROVIDER_API_KEY=
PAN_PROVIDER_API_KEY=

# --- Operations ------------------------------------------------------------
# Admins re-promoted to ADMIN on every session refresh, comma-separated. There is
# deliberately no hard-coded fallback in source (SEC-03), so leaving this blank
# means no permanent admin exists.
PERMANENT_ADMIN_EMAILS=
# Extra admins, comma-separated, granted ADMIN on first sign-in.
BOOTSTRAP_ADMIN_EMAILS=
# Orders generated after this local hour roll to the next day.
SUBSCRIPTION_CUTOFF_HOUR=20
APP_TIMEZONE=Asia/Kolkata

# --- Proxies ---------------------------------------------------------------
# The anonymous rate limits (grievance form and status lookup, the cron
# endpoint) count per visitor address, read from X-Forwarded-For from the
# right, past the proxies in front of the app. Loopback is always trusted.
# List every other proxy address here, comma-separated: IPs, or CIDR ranges
# such as 10.0.0.0/8. A malformed entry stops the app at startup.
# On Hostinger: the server's own IP, set once the real chain is confirmed on
# the first live deploy (DEPLOYMENT.md §2, "Trusted proxies").
# Left blank behind a front end that is not on loopback, EVERY visitor shares
# one bucket per limit: one visitor can use up the whole site's 5 grievance
# submissions per 10 minutes. That over-limits; it never lets anyone dodge a
# limit.
TRUSTED_PROXIES=
