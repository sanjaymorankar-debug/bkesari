# ---------------------------------------------------------------------------
# Milk & Dairy Products (bkesari.com) — copy to `.env` and fill in.
#
# NOTHING IN THIS FILE IS A REAL CREDENTIAL, and `.env` is gitignored. Fill the
# real values in on the server only.
#
# One .env per environment. A deployment connects ONLY to its own PostgreSQL
# database — one database per tier (dev, test, prod), never shared.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# dev | test | prod. Read from here, never hard-coded, so one build can serve
# any tier against its own database.
APP_ENV=dev
BASE_URL=https://dev.bkesari.com/milk

# The path prefix this app is served under. The hub at bkesari.com forwards
# /milk/ here WITHOUT stripping the prefix, so the app has to own it.
#
# It must match BASE_URL's path, and it must ALSO be set when the build is made
# (the deploy workflow does that) because Next inlines it into the client
# bundles. A build made with it but started without it serves the app at the
# root while every asset URL points at /milk/ — every page then loads as
# unstyled markup. Leave blank only if this app is served from the root of its
# own hostname with nothing in front of it.
BASE_PATH=/milk

# --- Database (PostgreSQL) -------------------------------------------------
# PostgreSQL 13 or newer (CI and the generated schema use 16). This app does
# not run on MySQL/MariaDB. Hostinger *shared* hosting offers only MySQL, so a
# deployment there needs a PostgreSQL database hosted elsewhere (a VPS or a
# managed provider) — see DEPLOYMENT.md.
#
# The whole connection string, e.g.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Add `?sslmode=require` when the provider requires TLS (managed providers
# generally do); `sslmode=no-verify` encrypts without checking the certificate
# chain. Percent-encode any URL-unsafe characters in the password.
DATABASE_URL=

# Alternatively leave DATABASE_URL blank and give the parts separately; they are
# composed into a postgresql:// URL. If both are set, DATABASE_URL wins.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=

# A SEPARATE database for `npm test`. The suite TRUNCATEs the application's
# tables between tests, so pointing this at a database with data you care
# about will erase it.
# Required to run the tests at all (tests/setup.ts throws without it); not used
# by the application itself, so it stays blank on a deployed server.
# Create it and give it the schema once, writing the URL out on the command
# line:
#   createdb dairy_bakery_test
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dairy_bakery_test npm run db:migrate
# (`$TEST_DATABASE_URL` would not work there: it lives here, not in your shell.)
TEST_DATABASE_URL=

# Connection ceiling. Managed providers cap concurrent connections well below a
# dedicated server; keep this under the plan's limit.
DATABASE_POOL_MAX=5

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=https://dev.bkesari.com/milk
# Optional Google sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Scheduled jobs --------------------------------------------------------
# Bearer token guarding the daily-order cron endpoint. Generate as above.
CRON_SECRET=

# --- Payments (Cashfree) ---------------------------------------------------
# Leave both blank on dev: payments then run in MOCK mode and take no money.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# --- Google Maps -----------------------------------------------------------
# Two DIFFERENT keys. The server key is IP-restricted and never reaches a
# browser; the public one is domain-restricted. Blank on dev falls back to
# manual address entry rather than failing.
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- PAN encryption --------------------------------------------------------
# Base64 32-byte AES-256-GCM key. Required before any PAN can be submitted;
# there is deliberately no plaintext fallback.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAN_ENCRYPTION_KEY=

# --- GST/PAN verification providers ---------------------------------------
# No provider chosen yet. Blank = self-declared mode: submissions are stored
# PENDING_VERIFICATION for an admin to confirm, never silently verified.
GST_PROVIDER_API_KEY=
PAN_PROVIDER_API_KEY=

# --- Operations ------------------------------------------------------------
# Admins re-promoted to ADMIN on every session refresh, comma-separated. There is
# deliberately no hard-coded fallback in source (SEC-03), so leaving this blank
# means no permanent admin exists.
PERMANENT_ADMIN_EMAILS=
# Extra admins, comma-separated, granted ADMIN on first sign-in.
BOOTSTRAP_ADMIN_EMAILS=
# Orders generated after this local hour roll to the next day.
SUBSCRIPTION_CUTOFF_HOUR=20
APP_TIMEZONE=Asia/Kolkata
